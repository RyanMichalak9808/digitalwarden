<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/ruleAppIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="16dp" />

        <TextView
            android:id="@+id/ruleAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="56dp">

        <Button
            android:id="@+id/ruleAllowBtn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Allow"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/rule_button_background"
            android:textColor="@color/rule_button_text" />

        <Button
            android:id="@+id/ruleTimeLimitBtn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Time Limit"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/rule_button_background"
            android:textColor="@color/rule_button_text" />

        <Button
            android:id="@+id/ruleBlockBtn"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Block"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:background="@drawable/rule_button_background"
            android:textColor="@color/rule_button_text" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="56dp"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/ruleMinutesLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Minutes/day:"
            android:textSize="13sp"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/ruleMinutesField"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:gravity="center"
            android:maxLength="4"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/ruleStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textColor="#888888"
        android:visibility="gone" />

</LinearLayout>
